{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": false,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist/vite",
    "allowImportingTsExtensions": false,
    "types": [
      "node",
      "vite/client"
    ],
    "incremental": false
  },
  "include": [
    "tools/build/vite.ts",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "tools/**/*.test.ts"
  ]
}

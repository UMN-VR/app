{
  // The app and its tests, as Vitest runs them: the app's settings, with Node's
  // types added because tests read files through Node. Node-only code stays in
  // tsconfig.node.json, without the DOM.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": []
}
